# Directory where trained models are persisted (joblib). Empty = in-memory only.
MODELS_DIR=./models
# If set, every /v1/* request must send header X-API-Key with this value.
AI_API_KEY=
# Comma-separated list of browser origins allowed by CORS (the backend calls server-to-server, so usually empty).
CORS_ORIGINS=
# Max request body in MB (bigger bodies get 413 PAYLOAD_TOO_LARGE). The schema also caps 200 000 rows / 8 000 000 cells.
MAX_BODY_MB=64
# Python logging level for the JSON access log (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO
# Store models in PostgreSQL instead of MODELS_DIR (needed on hosts with an ephemeral disk such as Render free)
DATABASE_URL=
# Delete models older than N days (0 = keep forever)
MODEL_TTL_DAYS=0
# Requests per minute per client (API key or IP) on /v1/* (0 = no limit). TRUST_PROXY=1 behind a reverse proxy.
RATE_LIMIT_PER_MIN=0
TRUST_PROXY=0
# Optional: GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>" when set
METRICS_TOKEN=
