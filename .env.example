# Directory where trained models are persisted (joblib). Empty = in-memory only.
MODELS_DIR=./models
# If set, every /v1/* request must send header X-API-Key with this value.
AI_API_KEY=
# Comma-separated list of browser origins allowed by CORS (the backend calls server-to-server, so usually empty).
CORS_ORIGINS=
# Max request body in MB (bigger bodies get 413 PAYLOAD_TOO_LARGE). The schema also caps 200 000 rows / 8 000 000 cells.
MAX_BODY_MB=64
# Python logging level for the JSON access log (DEBUG, INFO, WARNING)
LOG_LEVEL=INFO
